# Copy this file to .env and fill in your actual values.
# .env is .gitignored — never commit it.

# HuggingFace token (required for pyannote speaker diarization).
# Get one at https://huggingface.co/settings/tokens (free).
# Also accept the gated model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — China users / unstable HF connections benefit from the mirror.
# Already defaulted in the code; uncomment to override.
# HF_ENDPOINT=https://hf-mirror.com
